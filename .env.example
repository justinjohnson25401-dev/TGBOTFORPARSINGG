# Bot settings
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# Prodamus payment settings
PRODAMUS_SECRET=your_prodamus_secret
PRODAMUS_SHOP_ID=your_shop_id

# Google Drive settings
GDRIVE_CREDENTIALS_FILE=credentials.json
GDRIVE_FOLDER_ID=your_folder_id

# Database (optional, defaults to bot/data/database.db)
DATABASE_PATH=bot/data/database.db

# Webhook settings (optional, for production)
WEBHOOK_HOST=https://your-app.railway.app
USE_WEBHOOK=false

# Port for webhook server (optional)
PORT=8080
